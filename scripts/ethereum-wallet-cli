#!/usr/bin/env bash
#
# Container launcher for the Ethereum, Monad, and BNB Smart Chain wallet CLIs.
#
# This single script serves every entry point. scripts/monad-wallet-cli and
# scripts/bsc-wallet-cli are symlinks to this file, and the profile is selected from the
# invoked file name, so each launcher keeps its own image variable, config directory,
# and entry point.
#
set -euo pipefail

PROFILE=ethereum
PREFIX=ETHEREUM_WALLET
ENTRYPOINT_ARGS=()
case "$(basename "$0")" in
  monad-wallet-cli)
    PROFILE=monad
    PREFIX=MONAD_WALLET
    ENTRYPOINT_ARGS=(--entrypoint monad-wallet-cli)
    ;;
  bsc-wallet-cli)
    PROFILE=bsc
    PREFIX=BSC_WALLET
    ENTRYPOINT_ARGS=(--entrypoint bsc-wallet-cli)
    ;;
esac

# Resolve the image and the host directory that stores this profile's keystore.
IMAGE_VAR="${PREFIX}_IMAGE"
CONFIG_VAR="${PREFIX}_CONFIG_DIR"
IMAGE="${!IMAGE_VAR:-ghcr.io/vibe-wallets/ethereum-wallet-cli:main}"
CONFIG_ROOT="${XDG_CONFIG_HOME:-}"
if [[ "$CONFIG_ROOT" != /* ]]; then
  CONFIG_ROOT="$HOME/.config"
fi
CONFIG_DIR="${!CONFIG_VAR:-${CONFIG_ROOT}/${PROFILE}-wallet-cli}"
if [[ "$CONFIG_DIR" != /* ]]; then
  CONFIG_DIR="$PWD/$CONFIG_DIR"
fi

umask 077
mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"

# Allocate a TTY only when this launcher itself runs on one.
TTY_ARGS=(-i)
if [[ -t 0 && -t 1 ]]; then
  TTY_ARGS=(-it)
fi

# Optionally place the container on a user-created network for a local Anvil node.
NETWORK_VAR="${PREFIX}_DOCKER_NETWORK"
NETWORK_ARGS=()
if [[ -n ${!NETWORK_VAR:-} ]]; then
  NETWORK_ARGS=(--network "${!NETWORK_VAR}")
fi

# Forward only this profile's network and RPC settings into the container.
ENV_ARGS=()
for suffix in NETWORK RPC_URL; do
  name="${PREFIX}_${suffix}"
  if [[ -v $name ]]; then
    ENV_ARGS+=(--env "$name")
  fi
done

# Local builds are used as-is; remote tags are always refreshed.
if [[ "$IMAGE" != "ethereum-wallet-cli:local" ]]; then
  docker pull "$IMAGE" >&2
fi

exec docker run --rm "${TTY_ARGS[@]}" \
  --user "$(id -u):$(id -g)" \
  --cap-drop ALL --security-opt no-new-privileges \
  --read-only --tmpfs /tmp:rw,nosuid,nodev,size=64m \
  "${ENTRYPOINT_ARGS[@]}" \
  "${NETWORK_ARGS[@]}" \
  "${ENV_ARGS[@]}" \
  --mount "type=bind,source=$CONFIG_DIR,target=/data" \
  "$IMAGE" "$@"
