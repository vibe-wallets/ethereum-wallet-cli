# BNB Smart Chain mainnet is the command default. Use this override for testnet.
BSC_WALLET_NETWORK=testnet
BSC_WALLET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# BSC_WALLET_CONFIG_DIR=/absolute/path/to/bsc-wallet-state
# Use this only after `make build`; otherwise the public :main image is pulled.
# BSC_WALLET_IMAGE=ethereum-wallet-cli:local
# Optional Docker network for a separate local Anvil container. This is not
# passed into the wallet process; default Docker networking applies when unset.
# BSC_WALLET_DOCKER_NETWORK=wallet-test
