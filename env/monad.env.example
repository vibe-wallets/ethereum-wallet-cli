# Monad mainnet is the command default. Use this override for testnet.
MONAD_WALLET_NETWORK=testnet
MONAD_WALLET_RPC_URL=https://testnet-rpc.monad.xyz
# MONAD_WALLET_CONFIG_DIR=/absolute/path/to/monad-wallet-state
# Use this only after `make build`; otherwise the public :main image is pulled.
# MONAD_WALLET_IMAGE=ethereum-wallet-cli:local
# Optional Docker network for a separate local Anvil container. This is not
# passed into the wallet process; default Docker networking applies when unset.
# MONAD_WALLET_DOCKER_NETWORK=wallet-test
