# Ethereum mainnet is the command default. Use this override for Sepolia.
ETHEREUM_WALLET_NETWORK=testnet
ETHEREUM_WALLET_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ETHEREUM_WALLET_CONFIG_DIR=/absolute/path/to/ethereum-wallet-state
# Use this only after `make build`; otherwise the public :main image is pulled.
# ETHEREUM_WALLET_IMAGE=ethereum-wallet-cli:local
# Optional Docker network for a separate local Anvil container. This is not
# passed into the wallet process; default Docker networking applies when unset.
# ETHEREUM_WALLET_DOCKER_NETWORK=wallet-test
